---
import { url } from '../site/data'
import Layout from '../site/Layout.astro'
---

<Layout lang='zh' title='页面未找到 / Page not found'
  ><div class='page-intro'>
    <div class='eyebrow'>404</div><h1>这页笔记不在这里。</h1><p>
      The page may have moved, or it has not been published yet.
    </p>
  </div><a class='button' href={url('zh')}>返回首页</a>
  <a class='button secondary' href={url('zh', 'search')}>搜索笔记</a></Layout
>
