---
import '@waline/client/style'

import { t, type Lang } from './data'
import { walineServerURL } from './waline'

interface Props {
  lang: Lang
  path: string
}

const { lang, path } = Astro.props
const serverURL = walineServerURL
---

{
  serverURL && (
    <section class='comments' aria-labelledby='comments-title' data-pagefind-ignore>
      <div class='comments-heading'>
        <div>
          <div class='eyebrow'>{t(lang, '交流', 'Discussion')}</div>
          <h2 id='comments-title'>{t(lang, '评论', 'Comments')}</h2>
        </div>
        <span class='comments-count'>
          <span class='waline-comment-count' data-path={path}>
            —
          </span>{' '}
          {t(lang, '条评论', 'comments')}
        </span>
      </div>
      <p class='comments-note'>
        {t(
          lang,
          '无需登录。昵称必填，邮箱可选；填写邮箱仅用于头像与回复提醒，不会公开显示。',
          'No login required. A nickname is required and email is optional; email is only used for avatars and reply notifications.'
        )}
      </p>
      <waline-comments data-server={serverURL} data-path={path} data-lang={lang}>
        <div class='waline-root'>{t(lang, '评论加载中…', 'Loading comments…')}</div>
      </waline-comments>
    </section>
  )
}

<script>
  import { commentCount, init } from '@waline/client'

  class WalineComments extends HTMLElement {
    private cleanup?: () => void

    connectedCallback() {
      if (this.dataset.ready === 'true') return
      const serverURL = this.dataset.server
      const path = this.dataset.path
      const lang = this.dataset.lang === 'zh' ? 'zh-CN' : 'en-US'
      const root = this.querySelector<HTMLElement>('.waline-root')
      if (!serverURL || !path || !root) return

      this.dataset.ready = 'true'
      const instance = init({
        el: root,
        serverURL,
        path,
        lang,
        dark: 'html.dark',
        login: 'enable',
        meta: ['nick', 'mail'],
        requiredMeta: ['nick'],
        pageview: true,
        comment: true,
        reaction: false,
        imageUploader: false,
        emoji: [
          'https://unpkg.com/@waline/emojis@1.4.0/bmoji',
          'https://unpkg.com/@waline/emojis@1.4.0/weibo'
        ],
        locale: {
          placeholder:
            lang === 'zh-CN'
              ? '欢迎留言（支持 Markdown，无需登录）'
              : 'Leave a comment (Markdown supported, no login required)'
        }
      })
      commentCount({ serverURL, path })
      this.cleanup = () => instance?.destroy?.()
    }

    disconnectedCallback() {
      this.cleanup?.()
    }
  }

  if (!customElements.get('waline-comments'))
    customElements.define('waline-comments', WalineComments)
</script>
