---
import {
  catalog,
  dateLabel,
  entryUrl,
  local,
  t,
  url,
  visibleEntries,
  type Entry,
  type Lang
} from './data'
import Layout from './Layout.astro'
import Mark from './Mark.astro'

interface Props {
  lang: Lang
  entries: Entry[]
}
const { lang, entries } = Astro.props
const posts = visibleEntries(entries, lang)
  .filter((e) => e.data.kind === 'blog')
  .slice(0, 3)
---

<Layout {lang} title={t(lang, '首页', 'Home')} alternate={url(lang === 'zh' ? 'en' : 'zh')}>
  <section class='intro'>
    <div>
      <div class='eyebrow'>A PERSONAL KNOWLEDGE SPACE</div><h1>
        {local(catalog.profile.title, lang)}
      </h1><p>{local(catalog.profile.bio, lang)}</p><div class='intro-links'>
        <a href={url(lang, 'academic')}>{t(lang, '关于我', 'About me')} ↗</a><a
          href={url(lang, 'blog')}>{t(lang, '阅读博客', 'Read the blog')}</a
        >{catalog.profile.github && <a href={catalog.profile.github}>GitHub ↗</a>}
      </div>
    </div>
    <div class='identity-block'>
      <div class='initial'>
        <Mark size={68} />
      </div><div class='name'>{local(catalog.profile.name, lang)}</div><small
        >{t(lang, '个人主页 · 学习笔记', 'Personal website · Learning notes')}</small
      ><small style='margin-top:12px'
        >{t(lang, '保持好奇，持续记录。', 'Stay curious. Keep notes.')}</small>
    </div>
  </section>
  <div class='home-grid'>
    <section>
      <div class='section-heading'>
        <h2>{t(lang, '最近的思考', 'Recent writing')}<span>Blog</span></h2><a
          href={url(lang, 'blog')}>{t(lang, '全部文章', 'All posts')} ↗</a>
      </div>
      {
        posts.map((e) => (
          <a class='post-row' href={entryUrl(e)}>
            <>
              <div class='post-meta'>
                <span>{dateLabel(e.data.date, lang)}</span>
                {e.data.demo && <span class='sample'>{t(lang, '示例', 'SAMPLE')}</span>}
              </div>
              <h3>{e.data.title}</h3>
              <p>{e.data.description}</p>
            </>
          </a>
        ))
      }
      {!posts.length && <p>{t(lang, '还没有发布文章。', 'No published posts yet.')}</p>}
    </section><aside>
      <div class='section-heading'>
        <h2>{t(lang, '课程笔记', 'Course notes')}<span>Course</span></h2><a
          href={url(lang, 'course')}>{t(lang, '全部', 'All')} ↗</a>
      </div>
      {
        catalog.courses.slice(0, 2).map((c) => (
          <a class='course-mini' href={url(lang, 'course/' + c.slug)}>
            <>
              <div class='eyebrow'>{c.code}</div>
              <h3>{local(c.title, lang)}</h3>
              <div class='post-meta'>
                <>
                  <span>
                    {visibleEntries(entries, lang).filter((e) => e.data.course === c.slug).length}{' '}
                    {t(lang, '篇笔记', 'notes')}
                  </span>
                  <span>
                    {c.status === 'learning'
                      ? t(lang, '学习中', 'Learning')
                      : t(lang, '复习中', 'Reviewing')}
                  </span>
                </>
              </div>
            </>
          </a>
        ))
      }
      <div class='home-note'>
        <div class='eyebrow'>BEYOND THE NOTEBOOK</div><p>
          {t(lang, '有用的资源，有趣的朋友。', 'Useful resources. Interesting people.')}
        </p><a class='text-link' href={url(lang, 'links')}>Links</a><span class='sep'>/</span><a
          class='text-link'
          href={url(lang, 'friends')}>Friends</a>
      </div>
    </aside>
  </div>
  <section class='research-strip'>
    <div class='section-heading'>
      <h2>{t(lang, '学术与开源', 'Research & open source')}<span>Academic</span></h2><a
        href={url(lang, 'academic')}>{t(lang, '查看学术主页', 'Academic profile')} ↗</a>
    </div><div class='research-summary'>
      <p>
        {
          local(catalog.profile.about, lang)
        }
      </p>
    </div>
  </section>
</Layout>
