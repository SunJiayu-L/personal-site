---
import PublicationSection from '../components/user/PublicationSection.astro'
import {
  catalog,
  categories,
  dateLabel,
  entryUrl,
  local,
  t,
  url,
  visibleEntries,
  type Entry,
  type Lang
} from './data'
import Layout from './Layout.astro'
import PostList from './PostList.astro'

interface Props {
  lang: Lang
  path: string
  entries: Entry[]
}
const { lang, path, entries } = Astro.props
const parts = path.split('/')
const section = parts[0]
const visible = visibleEntries(entries, lang)
const blogs = visible.filter((e) => e.data.kind === 'blog')
const tags = [...new Set(visible.flatMap((e) => e.data.tags))].sort()
const series = [...new Set(blogs.map((e) => e.data.series).filter(Boolean))] as string[]
const tag = section === 'tags' ? decodeURIComponent(parts[1] || '') : undefined
const collection =
  section === 'series' ? decodeURIComponent(parts.slice(1).join('/') || '') : undefined
const currentCategory = section === 'blog' ? parts[1] : undefined
const posts = tag
  ? visible.filter((e) => e.data.tags.includes(tag))
  : collection
    ? blogs.filter((e) => e.data.series === collection)
    : currentCategory
      ? blogs.filter((e) => e.data.category === currentCategory)
      : blogs
const course = section === 'course' ? catalog.courses.find((c) => c.slug === parts[1]) : undefined
const notes = course
  ? visible.filter((e) => e.data.course === course.slug).sort((a, b) => a.data.order - b.data.order)
  : []
const title = tag
  ? '#' + tag
  : collection ||
    (course && local(course.title, lang)) ||
    {
      blog: 'Blog',
      academic: 'Academic',
      course: 'Course',
      friends: 'Friends',
      archives: t(lang, '文章归档', 'Archives')
    }[section] ||
    'Blog'
const subtitles: Record<string, string> = {
  blog: t(
    lang,
    '关于研究、技术，以及生活中的一些思考。',
    'Thoughts on research, technology, and everyday life.'
  ),
  academic: t(lang, '研究经历、论文与开源工作。', 'Research, publications, and open-source work.'),
  course: t(
    lang,
    '沿着问题学习，把理解写成笔记。',
    'Learning through questions, one note at a time.'
  ),
  friends: t(lang, '在各自的小世界里，保持连接。', 'Small corners of the internet, connected.'),
  archives: t(lang, '沿时间回看写下的每一篇文章。', 'A timeline of the things I have written.')
}
const publications = catalog.publications as unknown as Parameters<
  typeof PublicationSection
>[0]['publications']
const info =
  'Name: ' +
  local(catalog.profile.name, lang) +
  '\nLink: ' +
  new URL(url(lang), Astro.site).href +
  '\nDescription: ' +
  local(catalog.profile.bio, lang)
---

<Layout
  {lang}
  {title}
  section={['tags', 'series', 'archives'].includes(section) ? 'blog' : section}
  alternate={url(lang === 'zh' ? 'en' : 'zh', path)}
>
  {
    course && (
      <div class='breadcrumb'>
        <>
          <a href={url(lang, 'course')}>Course</a>
          <span>/</span>
          <span>{local(course.title, lang)}</span>
        </>
      </div>
    )
  }
  <header class='page-intro'>
    <div class='eyebrow'>
      {
        section === 'course'
          ? 'THE LEARNING NOTEBOOK'
          : section === 'academic'
            ? 'RESEARCH & OPEN SOURCE'
            : section === 'blog'
              ? 'THOUGHTS & OBSERVATIONS'
              : section === 'friends'
                ? 'PEOPLE & CONNECTIONS'
                : 'PERSONAL COLLECTION'
      }
    </div><h1>{title}</h1><p>
      {
        course
          ? local(course.description, lang)
          : subtitles[section] || t(lang, '相关笔记与文章。', 'Related notes and articles.')
      }
    </p>
  </header>
  {
    ['blog', 'tags', 'series', 'archives'].includes(section) && (
      <>
        <nav class='tabs' aria-label={t(lang, '博客分类', 'Blog categories')}>
          <a
            class:list={{ active: section === 'blog' && !currentCategory }}
            href={url(lang, 'blog')}
          >
            {t(lang, '全部', 'All')}
          </a>
          {categories.map((c) => (
            <a
              href={url(lang, 'blog/' + c.slug)}
              class:list={{ active: c.slug === currentCategory }}
            >
              {c.title}
            </a>
          ))}
        </nav>
        <div class='listing-layout'>
          <>
            <section>
              {section === 'archives' ? (
                [...new Set(blogs.map((e) => e.data.date.slice(0, 4)))].map((year) => (
                  <>
                    <h2 class='archive-year'>{year}</h2>
                    <PostList {lang} entries={blogs.filter((e) => e.data.date.startsWith(year))} />
                  </>
                ))
              ) : (
                <PostList {lang} entries={posts} />
              )}
            </section>
            <aside>
              <div class='sidebar-box'>
                <>
                  <div class='aside-label'>TAGS</div>
                  <div class='sidebar-tags'>
                    {tags.map((label) => (
                      <a href={url(lang, 'tags/' + encodeURIComponent(label))} class='tag'>
                        {label}
                      </a>
                    ))}
                  </div>
                </>
              </div>
              {!!series.length && (
                <div class='sidebar-box'>
                  <div class='aside-label'>{t(lang, '系列文章', 'SERIES')}</div>
                  {series.map((s) => (
                    <a href={url(lang, 'series/' + encodeURIComponent(s))}>{s}</a>
                  ))}
                </div>
              )}
            </aside>
          </>
        </div>
      </>
    )
  }
  {
    section === 'course' && !course && (
      <>
        <>
          <div class='course-grid'>
            {catalog.courses.map((c) => (
              <a class='course-card' href={url(lang, 'course/' + c.slug)}>
                <div class='course-card-top'>
                  <span class='eyebrow'>{c.code}</span>
                  <span class:list={['status', c.status]}>
                    {c.status === 'learning'
                      ? t(lang, '学习中', 'Learning')
                      : c.status === 'completed'
                        ? t(lang, '已完成', 'Completed')
                        : t(lang, '复习中', 'Reviewing')}
                  </span>
                </div>
                <h2>{local(c.title, lang)}</h2>
                <p>{local(c.description, lang)}</p>
                <div class='course-card-bottom'>
                  <span>
                    {visible.filter((e) => e.data.course === c.slug).length}{' '}
                    {t(lang, '篇笔记', 'notes')}
                    {c.demo ? ' · ' + t(lang, '示例课程', 'Sample course') : ''}
                  </span>
                  <span>{t(lang, '查看目录', 'Contents')} ↗</span>
                </div>
              </a>
            ))}
          </div>
          <p class='note-count'>
            {t(
              lang,
              '每门课程独立整理，笔记按章节顺序排列。',
              'Each course has its own notebook, ordered by chapter.'
            )}
          </p>
        </>
      </>
    )
  }
  {
    course && (
      <>
        <div class='section-heading'>
          <>
            <h2>{t(lang, '课程目录', 'Course contents')}</h2>
            <span class='muted'>
              {notes.length} {t(lang, '篇笔记', 'notes')}
            </span>
          </>
        </div>
        {notes.map((e, i) => (
          <a class='lesson-row' href={entryUrl(e)}>
            <span class='lesson-no'>{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{e.data.title}</h3>
              <p>{e.data.description}</p>
              {e.data.lang !== lang && (
                <span class='sample'>{e.data.lang === 'zh' ? '中文原文' : 'English original'}</span>
              )}
            </div>
            <span class='arrow'>→</span>
          </a>
        ))}
        {!notes.length && (
          <p>{t(lang, '这门课程还没有发布笔记。', 'No notes published for this course yet.')}</p>
        )}
        {course.source && (
          <p class='note-count'>
            <a class='text-link' href={course.source} target='_blank' rel='noopener noreferrer'>
              {t(lang, '原课程链接', 'Course source')} ↗
            </a>
          </p>
        )}
      </>
    )
  }
  {
    section === 'academic' && (
      <div class='academic-layout'>
        <>
          <nav class='sticky-nav' aria-label='Academic'>
            <>
              <div class='aside-label'>ON THIS PAGE</div>
              <a href='#about-me'>About Me</a>
              <a href='#publications'>Publications</a>
              <a href='#open-source'>Open-source Projects</a>
            </>
          </nav>
          <div data-pagefind-body data-pagefind-meta='section:Academic'>
            <>
              <section class='academic-section' id='about-me'>
                <>
                  <h2>About Me</h2>
                  <p class='academic-about'>{local(catalog.profile.about, lang)}</p>
                  <div class='intro-links'>
                    {catalog.profile.github && <a href={catalog.profile.github}>GitHub ↗</a>}
                    {catalog.profile.scholar && (
                      <a href={catalog.profile.scholar}>Google Scholar ↗</a>
                    )}
                    {catalog.profile.email && (
                      <a href={'mailto:' + catalog.profile.email}>Email ↗</a>
                    )}
                    {catalog.profile.cv && (
                      <a href={catalog.profile.cv} download>
                        Download CV ↗
                      </a>
                    )}
                  </div>
                </>
              </section>
              <section class='academic-section' id='publications'>
                <h2>Publications</h2>
                {catalog.publications.some((p) => p.demo) && (
                  <span class='sample'>
                    {t(
                      lang,
                      '排版示例 · 非真实发表记录',
                      'LAYOUT SAMPLE · Not a publication claim'
                    )}
                  </span>
                )}
                <PublicationSection {publications} />
                {!publications.length && (
                  <p>{t(lang, '论文资料待添加。', 'Publications will be added here.')}</p>
                )}
              </section>
              <section class='academic-section' id='open-source'>
                <h2>Open-source Projects</h2>
                {catalog.projects.map((p) => (
                  <div class='project-card'>
                    <h3>{local(p.title, lang)}</h3>
                    <span class='tag'>{local(p.role, lang)}</span>
                    <p>{local(p.description, lang)}</p>
                    {p.github && (
                      <div class='post-meta'>
                        <span>{p.github.language}</span>
                        <span>☆ {p.github.stars}</span>
                      </div>
                    )}
                    {p.url && (
                      <a class='text-link' href={p.url} target='_blank' rel='noopener noreferrer'>
                        GitHub ↗
                      </a>
                    )}
                    {p.demo && <span class='sample'>{t(lang, '示例', 'SAMPLE')}</span>}
                  </div>
                ))}
              </section>
            </>
          </div>
        </>
      </div>
    )
  }
  {
    section === 'friends' && (
      <>
        <>
          <section>
            <div class='section-heading'>
              <>
                <h2>{t(lang, '朋友们', 'Friends')}</h2>
                <span class='muted'>{catalog.friends.length}</span>
              </>
            </div>
            {catalog.friends.length ? (
              <div class='resource-grid'>
                {catalog.friends.map((f) => (
                  <a class='resource-card' href={f.url} target='_blank' rel='noopener noreferrer'>
                    {f.avatar ? (
                      <img
                        src={f.avatar}
                        class='resource-initial'
                        alt=''
                        width='40'
                        height='40'
                        loading='lazy'
                      />
                    ) : (
                      <span class='resource-initial'>{f.title.slice(0, 1)}</span>
                    )}
                    <div>
                      <h3>{f.title} ↗</h3>
                      <p>{local(f.description, lang)}</p>
                    </div>
                  </a>
                ))}
              </div>
            ) : (
              <div class='empty-state'>
                <h3>{t(lang, '给未来的朋友留一个位置', 'A place for future friends')}</h3>
                <p>
                  {t(
                    lang,
                    '友链名单尚未添加。这里将展示朋友们的网站。',
                    'No friend links yet. Their websites will appear here.'
                  )}
                </p>
              </div>
            )}
          </section>
          <section>
            <h2>{t(lang, '朋友的近况', 'From their notebooks')}</h2>
            {catalog.friendFeed.length ? (
              catalog.friendFeed.map((f) => (
                <a class='post-row' href={f.url} target='_blank' rel='noopener noreferrer'>
                  <div class='post-meta'>
                    <span>{f.friend}</span>
                    <time>{dateLabel(f.date, lang)}</time>
                  </div>
                  <h3>{f.title} ↗</h3>
                </a>
              ))
            ) : (
              <p class='note-count'>
                {t(
                  lang,
                  '添加友链的 RSS 后，这里会汇集最新文章。',
                  'Recent posts will appear when friends have RSS feeds.'
                )}
              </p>
            )}
          </section>
          <section class='friend-info'>
            <h2>{t(lang, '交换友链', 'Exchange links')}</h2>
            {catalog.demo ? (
              <p>
                {t(
                  lang,
                  '正式上线后，这里会提供本站信息与联系入口。',
                  'Site information and a contact link will appear after launch.'
                )}
              </p>
            ) : (
              <>
                <p>
                  {t(lang, '欢迎交流。本站信息如下：', 'Always happy to connect. Site details:')}
                </p>
                <pre id='friend-info-text'>{info}</pre>
                <button class='button secondary' id='copy-friend'>
                  {t(lang, '复制本站信息', 'Copy site details')}
                </button>
                {catalog.profile.email && (
                  <a class='button' href={'mailto:' + catalog.profile.email}>
                    {t(lang, '联系我', 'Get in touch')}
                  </a>
                )}
              </>
            )}
          </section>
        </>
      </>
    )
  }
  <script>
    document.querySelector('#copy-friend')?.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement
      try {
        await navigator.clipboard.writeText(
          document.querySelector('#friend-info-text')?.textContent || ''
        )
        b.textContent = document.documentElement.lang === 'zh' ? '已复制' : 'Copied'
      } catch {
        b.textContent =
          document.documentElement.lang === 'zh'
            ? '请手动复制上方文字'
            : 'Please copy the text above'
      }
    })
  </script>
</Layout>
